# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Generation models
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_SYNTHESIS_MODEL=gemini-3-flash-preview

# Embedding model (gemini-embedding-2 = latest; gemini-embedding-001 = stable)
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=3072

# Storage (local file path for Qdrant persistence, or :memory: for ephemeral)
QDRANT_URL=./qdrant_db
DB_PATH=semantic_vault.db

# Chunking
CHUNK_SIZE_CHARS=1600
CHUNK_OVERLAP_CHARS=200

# Retrieval
TOP_K=8
