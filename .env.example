# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Generation models
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_SYNTHESIS_MODEL=gemini-3-flash-preview

# Embedding model (gemini-embedding-2 = latest; gemini-embedding-001 = stable)
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=3072

# Storage (local file path for Qdrant persistence, or :memory: for ephemeral)
QDRANT_URL=./qdrant_db
DB_PATH=semantic_vault.db

# Chunking
CHUNK_SIZE_CHARS=1600
CHUNK_OVERLAP_CHARS=200

# Retrieval
TOP_K=8

# Phase 2 — Neo4j knowledge graph (leave blank to run Phase 1 only)
# Neo4j Community: https://neo4j.com/download/  or  Docker: docker run -p7687:7687 -p7474:7474 -e NEO4J_AUTH=neo4j/password neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Entity resolution thresholds (cosine similarity)
ER_HIGH_THRESHOLD=0.85
ER_LOW_THRESHOLD=0.65

# Phase 3 — agentic retrieval (all off by default; enable in .env as needed)
# ENABLE_QUERY_PLANNER=true   # decompose questions with Gemini before retrieval
# ENABLE_RERANKING=true       # LLM-as-judge reranking (uses extra Gemini call per query)
# ENABLE_AUTHORITY=true       # source authority weighting in synthesis
# RERANK_TOP_N=20             # candidate pool size sent to reranker
# ONTOLOGY_EVOLUTION_INTERVAL=10  # run ontology evolution every N ingestions
